# Shopify Admin API (solo servidor)
SHOPIFY_SHOP=nombre-de-la-tienda
SHOPIFY_CLIENT_ID=client-id-de-shopify
SHOPIFY_CLIENT_SECRET=client-secret-de-shopify

# Turso/libSQL (solo servidor)
TURSO_DATABASE_URL=libsql://nombre-base-organizacion.turso.io
TURSO_AUTH_TOKEN=token-de-autenticacion-de-turso

# OpenAI (solo servidor)
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_CONTENT_TEXT_MODEL=gpt-5.4-mini
OPENAI_CONTENT_IMAGE_MODEL=gpt-image-2

# Vercel Blob privado (OIDC, solo servidor)
BLOB_STORE_ID=store-id-de-blob
# Vercel lo inyecta en despliegues; en local se obtiene con `vercel env pull`.
VERCEL_OIDC_TOKEN=token-oidc-temporal
