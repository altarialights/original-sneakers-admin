---
import type { InventoryProductListItem } from '../../lib/inventory/types.ts';
import { formatMoney } from '../../lib/inventory/queries.ts';
import ActionMenu from '../ui/ActionMenu.astro';
import ProductThumbnail from '../ui/ProductThumbnail.astro';
import StatusBadge from '../ui/StatusBadge.astro';
interface Props { product: InventoryProductListItem; }
const { product } = Astro.props;
---

<article class="border-b border-slate-100 bg-white px-4 py-4 last:border-b-0">
  <div class="flex gap-3">
    <a href={`/stock/${product.id}`} class="flex min-w-0 flex-1 gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-blue-600"><ProductThumbnail imageUrl={product.imageUrl} alt={product.name} /><span class="min-w-0 pt-0.5"><span class="block truncate text-sm font-semibold">{product.model}</span><span class="mt-1 block truncate text-xs font-medium text-slate-500">{product.brand} · {product.reference}</span></span></a>
    <ActionMenu label={`Acciones para ${product.name}`}>
      <a href={`/stock/${product.id}`} class="block min-h-11 rounded-lg px-3 py-3 font-medium hover:bg-slate-50">Ver / editar</a>
      <button type="button" data-stock-open data-product={product.name} data-variant-id={product.variants[0]?.id} data-location-id={product.variants[0]?.locationId} data-size={product.sizes[0]} data-quantity={product.variants[0]?.quantity ?? 0} class="block min-h-11 w-full rounded-lg px-3 text-left hover:bg-slate-50">Ajustar stock</button>
      <a href={`/contenido?producto=${product.id}&panel=imagenes`} class="block min-h-11 rounded-lg px-3 py-3 hover:bg-slate-50">Crear imágenes</a>
      <button type="button" data-archive-open data-product-id={product.id} data-product={product.name} data-stock={product.stock} class="block min-h-11 w-full rounded-lg px-3 text-left text-rose-700 hover:bg-rose-50">Dar de baja</button>
    </ActionMenu>
  </div>
  <p class="mt-3 text-xs font-medium text-slate-500">{product.sizes.join(' · ')}</p>
  <div class="mt-3 grid grid-cols-2 items-end gap-3">
    <p class="text-sm font-semibold tabular-nums">{product.stock} unidades</p><p class="text-right text-base font-semibold tabular-nums">{formatMoney(product.priceCents)}</p>
    <div><StatusBadge status={product.stateLabel} compact /></div><div class="text-right"><StatusBadge status={`Shopify · ${product.shopifyStatus}`} compact /></div>
  </div>
</article>
