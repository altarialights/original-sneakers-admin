---
import Icon from './Icon.astro';
interface Props { label?: string; }
const { label = 'Abrir acciones' } = Astro.props;
---

<details class="relative" data-action-menu>
  <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" aria-label={label}><Icon name="more" /></summary>
  <div class="absolute right-0 z-20 mt-1 w-48 rounded-xl border border-slate-200 bg-white p-1.5 text-sm shadow-xl shadow-slate-950/10"><slot /></div>
</details>
