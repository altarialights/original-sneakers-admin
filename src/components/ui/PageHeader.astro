---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  backHref?: string;
  backLabel?: string;
}
const { title, description, eyebrow, backHref, backLabel = 'Volver' } = Astro.props;
---

<header class="mb-7 lg:mb-9">
  {backHref && <a href={backHref} class="mb-4 inline-flex min-h-11 items-center text-sm font-medium text-slate-500 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">← {backLabel}</a>}
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div class="min-w-0">
      {eyebrow && <p class="mb-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">{eyebrow}</p>}
      <h1 class="text-2xl font-semibold tracking-[-0.03em] text-slate-950 sm:text-3xl">{title}</h1>
      {description && <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 sm:text-base">{description}</p>}
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-2"><slot name="actions" /></div>
  </div>
</header>
