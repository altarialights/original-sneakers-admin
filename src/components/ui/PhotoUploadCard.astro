---
import Icon from './Icon.astro';
interface Props {
  id: 'caja' | 'ticket' | 'etiqueta' | 'etiquetaRopa' | 'prendaCompleta' | 'referenciaLateral' | 'referenciaFrontal' | 'referenciaTrasera';
  title: string;
  hint: string;
  exampleImage?: string;
  exampleAlt?: string;
  secondaryHint?: string;
  tone?: 'blue' | 'amber' | 'stone';
}
const { id, title, hint, exampleImage, exampleAlt, secondaryHint, tone = 'stone' } = Astro.props;
const tones = {
  blue: 'bg-blue-50 text-blue-700',
  amber: 'bg-amber-50 text-amber-700',
  stone: 'bg-slate-100 text-slate-600'
};
---

<article data-photo-card data-photo-kind={id} class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <div class="flex h-full flex-col p-4 sm:p-5">
    <div class="flex min-h-20 items-start gap-3">
      <span class:list={['grid size-10 shrink-0 place-items-center rounded-xl', tones[tone]]}><Icon name="image" /></span>
      <div><h3 class="font-semibold">{title}</h3><p class="mt-0.5 text-xs leading-5 text-slate-500">{hint}</p>{secondaryHint && <p class="mt-1 text-[11px] leading-4 text-slate-400">{secondaryHint}</p>}</div>
    </div>
    <div data-photo-empty data-photo-example class="relative mt-4 h-40 shrink-0 overflow-hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 p-3 sm:h-44">
      <span class="absolute left-3 top-3 z-10 rounded-full border border-slate-200 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500 shadow-sm">Ejemplo</span>
      {exampleImage ? <img src={exampleImage} alt={exampleAlt ?? ''} class="size-full object-contain opacity-70" loading="lazy" decoding="async" /> : <div class="grid size-full place-items-center text-center text-xs font-medium text-slate-400">Añade aquí una foto clara y completa</div>}
    </div>
    <div data-photo-preview class="relative mt-4 hidden h-40 overflow-hidden rounded-xl bg-slate-100 sm:h-44">
      <img alt={`Vista previa de ${title}`} class="absolute inset-0 size-full object-cover" />
      <div data-photo-loading class="absolute inset-0 hidden place-items-center bg-slate-950/55 px-4 text-center text-sm font-semibold text-white">
        <span><span class="mx-auto mb-2 block size-6 animate-spin rounded-full border-2 border-white/30 border-t-white"></span>Subiendo imagen…</span>
      </div>
      <span data-photo-uploaded class="absolute bottom-3 left-3 hidden items-center gap-1.5 rounded-full bg-white px-2.5 py-1.5 text-xs font-semibold text-emerald-700 shadow-sm"><Icon name="check" class="size-4" />Tu foto</span>
    </div>
    <p data-photo-error class="mt-3 hidden rounded-xl bg-rose-50 px-3 py-2.5 text-xs font-semibold leading-5 text-rose-800" role="alert"></p>
    <div class="mt-3 grid grid-cols-2 gap-2" data-photo-actions>
      <label class="grid min-h-11 cursor-pointer place-items-center rounded-xl bg-slate-950 px-2 text-center text-sm font-semibold text-white">Hacer foto<input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" class="sr-only" data-photo-input /></label>
      <label class="grid min-h-11 cursor-pointer place-items-center rounded-xl border border-slate-200 px-2 text-center text-sm font-semibold">Elegir foto<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-photo-input /></label>
    </div>
    <div data-photo-change class="mt-3 hidden grid-cols-2 gap-2">
      <label class="grid min-h-11 cursor-pointer place-items-center rounded-xl border border-slate-200 text-sm font-semibold">Cambiar<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-photo-input /></label>
      <button type="button" data-photo-remove class="min-h-11 rounded-xl text-sm font-semibold text-rose-700 hover:bg-rose-50">Eliminar</button>
    </div>
  </div>
</article>
