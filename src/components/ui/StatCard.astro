---
interface Props { label: string; value: string; detail?: string; tone?: 'default' | 'danger'; }
const { label, value, detail, tone = 'default' } = Astro.props;
---

<div class="border-r border-slate-200 px-1 last:border-r-0 sm:px-5 sm:first:pl-0 sm:last:pr-0">
  <dt class="text-sm font-medium text-slate-500">{label}</dt>
  <dd class:list={['mt-1.5 text-2xl font-semibold tracking-[-0.03em] tabular-nums', tone === 'danger' ? 'text-rose-700' : 'text-slate-950']}>{value}</dd>
  {detail && <p class="mt-1 text-xs text-slate-400">{detail}</p>}
</div>
