---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Original Sneakers Admin',
  description = 'Panel interno de gestión de Original Sneakers.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/avif" href="/onboarding/logo.avif" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-slate-950 text-slate-100 antialiased">
    <slot />
  </body>
</html>
