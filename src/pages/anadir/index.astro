---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
---

<AdminLayout title="Añadir producto" description="Elige cómo quieres darlo de alta.">
  <PageHeader title="Añadir producto" description="Elige cómo quieres darlo de alta." />
  <section class="mx-auto grid max-w-4xl gap-4 md:grid-cols-2" aria-label="Formas de añadir un producto">
    <a href="/anadir/fotos" class="group flex min-h-72 flex-col rounded-3xl bg-slate-950 p-6 text-white shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:p-7">
      <div class="flex items-start justify-between"><span class="grid size-12 place-items-center rounded-2xl bg-white/10"><Icon name="image" /></span><span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold">Recomendado</span></div>
      <div class="mt-auto"><p class="text-sm font-medium text-slate-300">La forma más rápida</p><h2 class="mt-1 text-2xl font-semibold tracking-tight">Con fotos</h2><p class="mt-2 max-w-sm text-sm leading-6 text-slate-300">Fotografía la caja, el ticket y la zapatilla. Después revisa los datos detectados.</p><span class="mt-5 inline-flex min-h-11 items-center font-semibold">Empezar <span class="ml-2" aria-hidden="true">→</span></span></div>
    </a>
    <a href="/anadir/manual" class="group flex min-h-72 flex-col rounded-3xl border border-slate-200 bg-white p-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:p-7">
      <span class="grid size-12 place-items-center rounded-2xl bg-slate-100 text-slate-600"><Icon name="edit" /></span>
      <div class="mt-auto"><p class="text-sm font-medium text-slate-500">Escribe los datos</p><h2 class="mt-1 text-2xl font-semibold tracking-tight">Manual</h2><p class="mt-2 max-w-sm text-sm leading-6 text-slate-500">Añade producto, talla, unidades y precio con un formulario corto.</p><span class="mt-5 inline-flex min-h-11 items-center font-semibold">Empezar <span class="ml-2" aria-hidden="true">→</span></span></div>
    </a>
  </section>
</AdminLayout>
