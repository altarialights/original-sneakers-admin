---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import FormField from '../../components/ui/FormField.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

export const prerender = false;
---

<AdminLayout title="Añadir manualmente" description="Completa solo la información necesaria.">
  <PageHeader title="Añadir manualmente" description="Completa solo la información necesaria." backHref="/anadir" backLabel="Formas de añadir">
    <Fragment slot="actions"><Button href="/stock">Cancelar</Button><button type="button" data-save-product class="inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white disabled:cursor-wait disabled:opacity-60">Guardar producto</button></Fragment>
  </PageHeader>
  <form class="mx-auto max-w-5xl space-y-5" data-product-form novalidate>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <h2 class="text-lg font-semibold">Producto</h2><p class="mt-1 text-sm text-slate-500">Datos comunes a todas las tallas.</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <FormField label="Marca" name="brand" placeholder="Nike" required />
        <FormField label="Modelo" name="model" placeholder="Dunk Low Panda" required />
        <FormField label="Referencia" name="reference" placeholder="DD1391-100" required />
        <FormField label="Colorway" name="colorway" placeholder="Negro / Blanco" />
        <label><span class="mb-1.5 block text-sm font-medium text-slate-700">Tipo *</span><select name="type" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3.5 text-sm"><option value="CALZADO">Calzado</option><option value="ROPA">Ropa</option><option value="ACCESORIO">Accesorio</option><option value="OTRO">Otro</option></select></label>
        <label><span class="mb-1.5 block text-sm font-medium text-slate-700">Género</span><select name="gender" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3.5 text-sm"><option value="DESCONOCIDO">Sin especificar</option><option value="UNISEX">Unisex</option><option value="HOMBRE">Hombre</option><option value="MUJER">Mujer</option><option value="NINO">Niño</option><option value="NINA">Niña</option></select></label>
        <label><span class="mb-1.5 block text-sm font-medium text-slate-700">Edad</span><select name="ageGroup" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3.5 text-sm"><option value="DESCONOCIDO">Sin especificar</option><option value="BEBE">Bebé</option><option value="INFANTIL">Infantil</option><option value="ADULTO">Adulto</option></select></label>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <div class="flex items-center justify-between gap-4"><div><h2 class="text-lg font-semibold">Variantes y stock</h2><p class="mt-1 text-sm text-slate-500">Añade una fila por talla. Cada cantidad crea su movimiento de entrada.</p></div><button type="button" data-add-size class="min-h-11 shrink-0 rounded-xl border border-slate-200 px-3 text-sm font-semibold">+ Añadir talla</button></div>
      <div data-variants class="mt-6 space-y-3">
        <fieldset data-variant class="rounded-xl bg-slate-50 p-4"><legend class="sr-only">Talla</legend><div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <label><span class="mb-1.5 block text-sm font-medium">Talla *</span><input data-field="size" placeholder="42.5" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">Sistema *</span><select data-field="sizeSystem" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option>EU</option><option>US</option><option>UK</option><option>CM</option><option>ALFABETICO</option><option>EDAD</option><option>ALTURA</option><option>DESCONOCIDO</option></select></label>
          <label><span class="mb-1.5 block text-sm font-medium">Cantidad *</span><input data-field="quantity" type="number" min="1" step="1" value="1" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">Ubicación *</span><input data-field="location" value="Tienda" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">PVP *</span><input data-field="pvp" inputmode="decimal" placeholder="119,99" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">Precio oferta</span><input data-field="offer" inputmode="decimal" placeholder="89,90" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">Coste *</span><input data-field="cost" inputmode="decimal" placeholder="50,00" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
          <label><span class="mb-1.5 block text-sm font-medium">UPC</span><input data-field="barcode" inputmode="numeric" autocomplete="off" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
        </div><button type="button" data-remove-size class="mt-2 hidden min-h-11 text-sm font-semibold text-rose-700">Quitar talla</button></fieldset>
      </div>
    </section>
    <p data-form-error class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800" role="alert"></p>
    <section data-duplicate class="hidden rounded-2xl border border-amber-200 bg-amber-50 p-5"><h2 class="font-semibold text-amber-950">Este producto ya existe.</h2><p class="mt-1 text-sm text-amber-800">Puedes abrirlo, añadirle estas nuevas tallas o cancelar.</p><div class="mt-4 flex flex-wrap gap-2"><a data-open-existing class="grid min-h-11 place-items-center rounded-xl border border-amber-300 bg-white px-4 text-sm font-semibold">Abrir producto existente</a><button type="button" data-add-existing class="min-h-11 rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white">Añadir nuevas tallas</button><button type="button" data-cancel-existing class="min-h-11 rounded-xl px-4 text-sm font-semibold">Cancelar</button></div></section>
  </form>
  <template id="variant-template"><fieldset data-variant class="rounded-xl bg-slate-50 p-4"><legend class="sr-only">Otra talla</legend><div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <label><span class="mb-1.5 block text-sm font-medium">Talla *</span><input data-field="size" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">Sistema *</span><select data-field="sizeSystem" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option>EU</option><option>US</option><option>UK</option><option>CM</option><option>ALFABETICO</option><option>EDAD</option><option>ALTURA</option><option>DESCONOCIDO</option></select></label><label><span class="mb-1.5 block text-sm font-medium">Cantidad *</span><input data-field="quantity" type="number" min="1" step="1" value="1" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">Ubicación *</span><input data-field="location" value="Tienda" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">PVP *</span><input data-field="pvp" inputmode="decimal" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">Precio oferta</span><input data-field="offer" inputmode="decimal" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">Coste *</span><input data-field="cost" inputmode="decimal" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label><label><span class="mb-1.5 block text-sm font-medium">UPC</span><input data-field="barcode" inputmode="numeric" autocomplete="off" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3" /></label>
  </div><button type="button" data-remove-size class="mt-2 min-h-11 text-sm font-semibold text-rose-700">Quitar talla</button></fieldset></template>
  <script>
    document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-product-form]');
    if (!form) return;
    const variants = document.querySelector<HTMLElement>('[data-variants]')!; const template = document.querySelector<HTMLTemplateElement>('#variant-template')!; const errorBox = document.querySelector<HTMLElement>('[data-form-error]')!; const duplicateBox = document.querySelector<HTMLElement>('[data-duplicate]')!; let existingProductId = '';
    document.querySelector('[data-add-size]')?.addEventListener('click', () => variants.append(template.content.cloneNode(true)));
    variants.addEventListener('click', (event) => (event.target as HTMLElement).closest('[data-remove-size]')?.closest('[data-variant]')?.remove());
    const value = (selector: string) => (form.querySelector<HTMLInputElement | HTMLSelectElement>(selector)?.value ?? '').trim();
    const payload = () => ({ brand: value('[name=brand]'), model: value('[name=model]'), reference: value('[name=reference]'), colorway: value('[name=colorway]'), type: value('[name=type]'), variants: [...variants.querySelectorAll<HTMLElement>('[data-variant]')].map((row) => { const get = (name: string) => (row.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-field=${name}]`)?.value ?? '').trim(); return { size: get('size'), sizeSystem: get('sizeSystem'), quantity: get('quantity'), pvp: get('pvp'), offer: get('offer'), cost: get('cost'), barcode: get('barcode'), location: get('location'), gender: value('[name=gender]'), ageGroup: value('[name=ageGroup]') }; }) });
    const send = async (url: string) => { const response = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(url.endsWith('/variants') ? { variants: payload().variants } : payload()) }); const data = await response.json(); if (!response.ok) { const failure = new Error(data.message ?? 'No hemos podido guardar el producto.') as Error & { data?: typeof data }; failure.data = data; throw failure; } return data; };
    const showError = (message: string) => { errorBox.textContent = message; errorBox.classList.remove('hidden'); };
    const saveButton = document.querySelector<HTMLButtonElement>('[data-save-product]')!;
    saveButton.addEventListener('click', async () => { errorBox.classList.add('hidden'); duplicateBox.classList.add('hidden'); saveButton.disabled = true; saveButton.textContent = 'Guardando…'; try { const result = await send('/api/inventory/products'); window.location.assign(`/stock/${result.productId}?success=Producto+añadido`); } catch (cause) { const failure = cause as Error & { data?: { code?: string; productId?: string } }; if (failure.data?.code === 'PRODUCTO_DUPLICADO' && failure.data.productId) { existingProductId = failure.data.productId; document.querySelector<HTMLAnchorElement>('[data-open-existing]')!.href = `/stock/${existingProductId}`; duplicateBox.classList.remove('hidden'); } else showError(failure.message); } finally { saveButton.disabled = false; saveButton.textContent = 'Guardar producto'; } });
    document.querySelector('[data-add-existing]')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; button.disabled = true; button.textContent = 'Guardando…'; try { await send(`/api/inventory/products/${existingProductId}/variants`); window.location.assign(`/stock/${existingProductId}?success=Producto+añadido`); } catch (cause) { showError(cause instanceof Error ? cause.message : 'No hemos podido añadir las tallas.'); } finally { button.disabled = false; button.textContent = 'Añadir nuevas tallas'; } });
    document.querySelector('[data-cancel-existing]')?.addEventListener('click', () => duplicateBox.classList.add('hidden'));
    });
  </script>
</AdminLayout>
