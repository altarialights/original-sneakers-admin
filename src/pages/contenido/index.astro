---
import AdminLayout from '../../layouts/AdminLayout.astro';
import FilterBar from '../../components/stock/FilterBar.astro';
import Icon from '../../components/ui/Icon.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ProductThumbnail from '../../components/ui/ProductThumbnail.astro';
import { getFilterOptions, listProducts } from '../../lib/inventory/queries.ts';
import type { InventoryListFilters, ProductState, ProductType } from '../../lib/inventory/types.ts';

export const prerender = false;

const legacyProductId = Astro.url.searchParams.get('producto')?.trim();
if (legacyProductId) return Astro.redirect(`/contenido/${encodeURIComponent(legacyProductId)}`);

const param = (name: string) => Astro.url.searchParams.get(name)?.trim() ?? '';
const state = param('estado');
const type = param('tipo');
const stock = param('stock');
const filters: InventoryListFilters = {
  search: param('q'),
  brand: param('marca'),
  size: param('talla'),
  state: ['BORRADOR', 'ACTIVO', 'ARCHIVADO'].includes(state) ? state as ProductState : '',
  type: ['CALZADO', 'ROPA', 'ACCESORIO', 'OTRO'].includes(type) ? type as ProductType : '',
  stock: ['con', 'sin'].includes(stock) ? stock as 'con' | 'sin' : ''
};

let loadError = false;
let products: Awaited<ReturnType<typeof listProducts>> = [];
let filterOptions = { brands: [] as string[], sizes: [] as string[] };
try {
  [products, filterOptions] = await Promise.all([listProducts(filters), getFilterOptions()]);
} catch (error) {
  console.error('[content] No se pudo cargar el catálogo de productos.', error);
  loadError = true;
}
---

<AdminLayout title="Contenido" description="Crea imágenes y textos para los productos del stock.">
  <PageHeader title="Contenido" description="Elige un producto del stock para crear o editar sus imágenes y textos." />

  {loadError ? (
    <section class="rounded-2xl border border-rose-200 bg-white p-8 text-center">
      <h2 class="font-semibold">No hemos podido cargar los productos.</h2>
      <a href={Astro.url.pathname + Astro.url.search} class="mt-4 inline-grid min-h-11 place-items-center rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white">Reintentar</a>
    </section>
  ) : <>
    <section class="space-y-3" aria-label="Buscar y filtrar productos para contenido">
      <form method="get" class="relative block">
        {filters.brand && <input type="hidden" name="marca" value={filters.brand} />}
        {filters.size && <input type="hidden" name="talla" value={filters.size} />}
        {filters.state && <input type="hidden" name="estado" value={filters.state} />}
        {filters.type && <input type="hidden" name="tipo" value={filters.type} />}
        {filters.stock && <input type="hidden" name="stock" value={filters.stock} />}
        <label>
          <span class="sr-only">Buscar productos</span>
          <Icon name="search" class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400" />
          <input name="q" value={filters.search} type="search" placeholder="Buscar marca, modelo, referencia, UPC, talla..." class="min-h-12 w-full rounded-xl border border-slate-200 bg-white pl-12 pr-24 text-base outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
        </label>
        <button class="absolute right-1.5 top-1.5 min-h-9 rounded-lg bg-slate-950 px-4 text-sm font-semibold text-white">Buscar</button>
      </form>
      <FilterBar options={filterOptions} current={filters} clearHref="/contenido" />
    </section>

    <section class="mt-6" aria-labelledby="content-products-title">
      <div class="mb-4">
        <h2 id="content-products-title" class="font-semibold">Productos del stock</h2>
        <p class="mt-1 text-sm text-slate-500">{products.length} producto{products.length === 1 ? '' : 's'}</p>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {products.map((product) => (
            <article class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
              <a href={`/contenido/${encodeURIComponent(product.id)}`} class="block overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" aria-label={`Abrir contenido de ${product.name}`}>
                <ProductThumbnail imageUrl={product.imageUrl} alt={product.name} size="lg" />
              </a>
              <div class="flex flex-1 flex-col px-1 pb-1 pt-3">
                <h3 class="line-clamp-2 text-sm font-semibold leading-5">{product.brand} · {product.model}</h3>
                <p class="mt-1 truncate text-xs text-slate-500">{product.reference}{product.colorway ? ` · ${product.colorway}` : ''}</p>
                <p class="mt-2 text-xs font-medium text-slate-500">{product.stock} unidad{product.stock === 1 ? '' : 'es'} en stock</p>
                <a href={`/contenido/${encodeURIComponent(product.id)}`} class="mt-4 grid min-h-11 w-full place-items-center rounded-xl bg-slate-950 px-3 text-center text-sm font-semibold text-white hover:bg-slate-800">Crear contenido</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <p class="font-semibold">No hay productos que coincidan.</p>
          <a href="/contenido" class="mt-3 inline-block text-sm font-semibold text-blue-700">Limpiar búsqueda</a>
        </div>
      )}
    </section>
  </>}
</AdminLayout>
