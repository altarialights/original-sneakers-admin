---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ActionMenu from '../../components/ui/ActionMenu.astro';
import Button from '../../components/ui/Button.astro';
import Modal from '../../components/ui/Modal.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ProductThumbnail from '../../components/ui/ProductThumbnail.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { formatMoney, getProductDetail } from '../../lib/inventory/queries.ts';
import { getProductContent } from '../../lib/content/queries.ts';

export const prerender = false;
let loadError = false;
let product: Awaited<ReturnType<typeof getProductDetail>> = null;
let content: Awaited<ReturnType<typeof getProductContent>> = null;
try {
  if (Astro.params.id) [product, content] = await Promise.all([getProductDetail(Astro.params.id), getProductContent(Astro.params.id)]);
} catch (error) { console.error('[inventory] No se pudo cargar el detalle de stock.', error); loadError = true; }
if (!loadError && !product) Astro.response.status = 404;
const success = Astro.url.searchParams.get('success');
const typeLabels = { CALZADO: 'Calzado', ROPA: 'Ropa', ACCESORIO: 'Accesorio', OTRO: 'Otro' } as const;
const genderLabels = { UNISEX: 'Unisex', HOMBRE: 'Hombre', MUJER: 'Mujer', NINO: 'Niño', NINA: 'Niña', DESCONOCIDO: 'Sin especificar' } as const;
const ageLabels = { BEBE: 'Bebé', INFANTIL: 'Infantil', ADULTO: 'Adulto', DESCONOCIDO: 'Sin especificar' } as const;
const defaultVariant = product?.variants.find((variant) => variant.quantity > 0) ?? product?.variants[0] ?? null;
const defaultLocation = defaultVariant?.locations.find((location) => location.quantity > 0) ?? defaultVariant?.locations[0] ?? null;
const addVariantDefaults = {
  size: '',
  sizeSystem: defaultVariant?.sizeSystem ?? (product?.type === 'ROPA' ? 'ALFABETICO' : 'EU'),
  quantity: '1',
  location: defaultLocation?.name ?? 'Tienda',
  pvp: defaultVariant ? String((defaultVariant.compareAtPriceCents ?? defaultVariant.priceCents) / 100) : '',
  offer: defaultVariant?.compareAtPriceCents === null || defaultVariant?.compareAtPriceCents === undefined ? '' : String(defaultVariant.priceCents / 100),
  cost: defaultVariant?.costCents === null || defaultVariant?.costCents === undefined ? '' : String(defaultVariant.costCents / 100),
  barcode: defaultVariant?.barcode ?? '',
  gender: defaultVariant?.gender ?? 'DESCONOCIDO',
  ageGroup: defaultVariant?.ageGroup ?? 'DESCONOCIDO'
};
---

<AdminLayout title={product?.name ?? 'Producto'} description={product ? `${product.reference} · ${product.brand}` : 'Detalle de producto'}>
  {loadError ? <section class="rounded-2xl border border-rose-200 bg-white p-8 text-center"><h1 class="text-xl font-semibold">No hemos podido cargar el stock.</h1><a href={Astro.url.pathname} class="mt-4 inline-grid min-h-11 place-items-center rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white">Reintentar</a></section> : !product ? <section class="rounded-2xl border border-slate-200 bg-white p-8 text-center"><h1 class="text-xl font-semibold">Producto no encontrado</h1><p class="mt-2 text-sm text-slate-500">Puede que se haya dado de baja o que el enlace no sea correcto.</p><a href="/stock" class="mt-4 inline-grid min-h-11 place-items-center rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white">Volver a stock</a></section> : <>
    <PageHeader title={product.name} description={product.reference} backHref="/stock" backLabel="Volver a stock">
      <Fragment slot="actions">
        {product.state !== 'ARCHIVADO' && <><Button dataDialogOpen="edit-product">Editar producto</Button><Button dataDialogOpen="adjust-stock" variant="primary">Ajustar stock</Button></>}
        {product.state !== 'ARCHIVADO' && <ActionMenu><button type="button" data-dialog-open="archive-product" class="block min-h-11 w-full rounded-lg px-3 text-left font-medium text-rose-700 hover:bg-rose-50">Dar de baja</button></ActionMenu>}
      </Fragment>
    </PageHeader>
    {success && <p class="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" role="status">{success}</p>}

    <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,.8fr)]">
      <section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
        {product.images.length > 0 ? <div data-product-gallery class="grid gap-3 sm:grid-cols-[4.5rem_1fr]">
          <div class="order-2 flex gap-2 overflow-x-auto pb-1 sm:order-1 sm:flex-col sm:overflow-visible">{product.images.map((image, index) => <button type="button" data-gallery-thumb data-image-url={image} aria-label={`Mostrar imagen ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'} class:list={['shrink-0 rounded-xl ring-2 ring-offset-2 transition', index === 0 ? 'ring-slate-950' : 'ring-transparent hover:ring-slate-300']}><img src={image} alt="" class="aspect-square w-16 rounded-xl object-cover ring-1 ring-slate-200 sm:w-full" loading="lazy" /></button>)}</div>
          <div class="order-1 sm:order-2">
            <div class="aspect-square overflow-hidden rounded-2xl bg-stone-100"><img data-gallery-main src={product.images[0]} alt={product.name} class="size-full object-cover" /></div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <a data-download-current href={`${product.images[0]}?download=1`} class="inline-grid min-h-11 place-items-center rounded-xl border border-slate-200 px-4 text-sm font-semibold hover:bg-slate-50">Descargar una</a>
              <button type="button" data-download-all class="min-h-11 rounded-xl bg-slate-950 px-4 text-sm font-semibold text-white disabled:opacity-50">Descargar todas</button>
            </div>
            <p data-download-status class="mt-2 hidden text-xs text-slate-500" role="status"></p>
          </div>
        </div> : <ProductThumbnail alt={product.name} size="lg" />}
        <p class="mt-3 text-xs text-slate-400">{product.images.length > 0 ? `${product.images.length} imagen${product.images.length === 1 ? '' : 'es'}` : 'Sin imágenes todavía'}</p>
      </section>
      <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
        <div class="flex items-center justify-between"><h2 class="text-lg font-semibold">Producto</h2><StatusBadge status={product.stateLabel} /></div>
        <dl class="mt-6 grid grid-cols-2 gap-x-5 gap-y-6">
          <div><dt class="text-xs font-medium text-slate-400">Marca</dt><dd class="mt-1 text-sm font-semibold">{product.brand}</dd></div><div><dt class="text-xs font-medium text-slate-400">Modelo</dt><dd class="mt-1 text-sm font-semibold">{product.model}</dd></div><div><dt class="text-xs font-medium text-slate-400">Referencia</dt><dd class="mt-1 text-sm font-semibold">{product.reference}</dd></div><div><dt class="text-xs font-medium text-slate-400">Colorway</dt><dd class="mt-1 text-sm font-semibold">{product.colorway ?? 'Sin especificar'}</dd></div><div><dt class="text-xs font-medium text-slate-400">Tipo</dt><dd class="mt-1 text-sm font-semibold">{typeLabels[product.type]}</dd></div><div><dt class="text-xs font-medium text-slate-400">Género</dt><dd class="mt-1 text-sm font-semibold">{[...new Set(product.variants.map((variant) => genderLabels[variant.gender]))].join(', ')}</dd></div><div><dt class="text-xs font-medium text-slate-400">Edad</dt><dd class="mt-1 text-sm font-semibold">{[...new Set(product.variants.map((variant) => ageLabels[variant.ageGroup]))].join(', ')}</dd></div><div><dt class="text-xs font-medium text-slate-400">Stock total</dt><dd class="mt-1 text-sm font-semibold">{product.stock} unidades</dd></div>
        </dl>
      </section>
    </div>

    <section class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <header class="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-lg font-semibold">Tallas y stock</h2><p class="mt-1 text-sm text-slate-500">{product.stock} unidades disponibles</p></div>{product.state !== 'ARCHIVADO' && <div class="flex gap-2"><Button dataDialogOpen="add-variant" icon="plus">Añadir talla</Button><Button dataDialogOpen="adjust-stock" variant="primary">Ajustar stock</Button></div>}</header>
      <div class="hidden overflow-x-auto md:block"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs text-slate-500"><tr><th class="px-5 py-3">Talla</th><th class="px-3 py-3">Original</th><th class="px-3 py-3">UPC</th><th class="px-3 py-3">Cantidad</th><th class="px-3 py-3">PVP / oferta</th><th class="px-3 py-3">Coste</th><th class="px-3 py-3">Ubicación</th><th class="px-3 py-3"></th></tr></thead><tbody class="divide-y divide-slate-100">{product.variants.map((variant) => <tr><td class="px-5 py-4 font-semibold">{variant.size} <span class="text-xs text-slate-400">{variant.sizeSystem}</span></td><td class="px-3 py-4 text-xs text-slate-500">{variant.originalSize}</td><td class="px-3 py-4 text-xs">{variant.barcode ?? '—'}</td><td class="px-3 py-4 font-semibold tabular-nums">{variant.quantity}</td><td class="px-3 py-4 tabular-nums"><span>{formatMoney(variant.compareAtPriceCents ?? variant.priceCents)}</span>{variant.compareAtPriceCents !== null && <span class="block text-xs font-semibold text-emerald-700">{formatMoney(variant.priceCents)}</span>}</td><td class="px-3 py-4 tabular-nums text-slate-500">{formatMoney(variant.costCents)}</td><td class="px-3 py-4 text-xs">{variant.locations.map((location) => `${location.name} (${location.quantity})`).join(', ') || 'Sin nivel'}</td><td class="px-3 py-4"><div class="flex"><button type="button" data-variant-edit data-variant={JSON.stringify(variant)} class="min-h-11 rounded-xl px-3 text-xs font-semibold text-slate-600 hover:bg-slate-100">Editar</button><button type="button" data-variant-stock data-variant-id={variant.id} data-size={variant.size} data-quantity={variant.quantity} data-location-id={variant.locations[0]?.id} class="min-h-11 rounded-xl px-3 text-xs font-semibold text-slate-600 hover:bg-slate-100">Ajustar</button></div></td></tr>)}</tbody></table></div>
      <div class="divide-y divide-slate-100 md:hidden">{product.variants.map((variant) => <article class="p-4"><div class="flex items-center justify-between"><p class="text-lg font-semibold">{variant.size} <span class="text-xs text-slate-400">{variant.sizeSystem}</span></p><StatusBadge status={variant.quantity > 0 ? 'Disponible' : 'Sin stock'} compact /></div><dl class="mt-4 grid grid-cols-3 gap-3"><div><dt class="text-xs text-slate-400">Cantidad</dt><dd class="mt-1 text-sm font-semibold">{variant.quantity}</dd></div><div><dt class="text-xs text-slate-400">PVP</dt><dd class="mt-1 text-sm font-semibold">{formatMoney(variant.compareAtPriceCents ?? variant.priceCents)}</dd></div><div><dt class="text-xs text-slate-400">Coste</dt><dd class="mt-1 text-sm font-semibold">{formatMoney(variant.costCents)}</dd></div></dl><p class="mt-3 text-xs text-slate-500">UPC: {variant.barcode ?? 'No disponible'} · {variant.locations.map((location) => location.name).join(', ') || 'Sin ubicación'}</p>{product.state !== 'ARCHIVADO' && <div class="mt-3 grid grid-cols-2 gap-2"><button type="button" data-variant-edit data-variant={JSON.stringify(variant)} class="min-h-11 rounded-xl border border-slate-200 text-sm font-semibold">Editar</button><button type="button" data-variant-stock data-variant-id={variant.id} data-size={variant.size} data-quantity={variant.quantity} data-location-id={variant.locations[0]?.id} class="min-h-11 rounded-xl bg-slate-100 text-sm font-semibold">Ajustar stock</button></div>}</article>)}</div>
    </section>

    <section class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-semibold">Textos de publicación</h2><p class="mt-1 text-sm text-slate-500">Última versión editorial guardada para este producto.</p></div>
        <a href={`/contenido/${encodeURIComponent(product.id)}`} class="inline-grid min-h-11 place-items-center rounded-xl border border-slate-200 px-4 text-sm font-semibold hover:bg-slate-50">Editar textos</a>
      </div>
      {content?.hasTexts ? <div class="mt-5 grid gap-4 lg:grid-cols-2">
        <article class="rounded-xl bg-slate-50 p-4"><h3 class="text-sm font-semibold">Título comercial</h3><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700">{content.texts.tituloComercial || 'Sin contenido'}</p></article>
        <article class="rounded-xl bg-slate-50 p-4"><h3 class="text-sm font-semibold">SEO title</h3><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700">{content.texts.seoTitle || 'Sin contenido'}</p></article>
        <article class="rounded-xl bg-slate-50 p-4 lg:col-span-2"><h3 class="text-sm font-semibold">Descripción completa</h3><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700">{content.texts.descripcionCompleta || 'Sin contenido'}</p></article>
        <article class="rounded-xl bg-slate-50 p-4 lg:col-span-2"><h3 class="text-sm font-semibold">Meta description</h3><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700">{content.texts.metaDescription || 'Sin contenido'}</p></article>
      </div> : <p class="mt-5 rounded-xl bg-slate-50 p-4 text-sm text-slate-600">Todavía no hay textos generados para este producto.</p>}
    </section>

    <Modal id="adjust-stock" title="Ajustar stock" description={`${product.name} · el cambio quedará registrado`}><label class="block"><span class="mb-1.5 block text-sm font-medium">Talla</span><select data-size-select class="min-h-12 w-full rounded-xl border border-slate-200 bg-white px-3">{product.variants.map((variant) => <option value={variant.id} data-quantity={variant.quantity} data-location-id={variant.locations[0]?.id}>{variant.size} {variant.sizeSystem}</option>)}</select></label><p class="mt-4 rounded-xl bg-slate-50 p-3 text-sm">Cantidad actual: <strong data-stock-current>{product.variants[0]?.quantity ?? 0}</strong></p><label class="mt-4 block"><span class="mb-1.5 block text-sm font-medium">Motivo</span><select data-stock-reason class="min-h-12 w-full rounded-xl border border-slate-200 bg-white px-3"><option value="VENTA">Venta</option><option value="COMPRA">Compra / entrada</option><option value="AJUSTE">Ajuste</option><option value="DEVOLUCION">Devolución</option></select></label><label class="mt-4 block"><span class="mb-1.5 block text-sm font-medium">Cambio de unidades</span><input data-stock-delta type="number" step="1" value="-1" class="min-h-12 w-full rounded-xl border border-slate-200 px-3" /></label><p data-stock-error class="mt-3 hidden text-sm font-medium text-rose-700"></p><div class="mt-6 grid grid-cols-2 gap-2"><button type="button" data-dialog-close class="min-h-12 rounded-xl border border-slate-200 font-semibold">Cancelar</button><button type="button" data-stock-save class="min-h-12 rounded-xl bg-slate-950 font-semibold text-white">Guardar</button></div></Modal>

    <Modal id="edit-product" title="Editar producto" description="Estos cambios no modifican el stock."><div data-edit-product-form class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium">Marca<input data-field="brand" value={product.brand} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Modelo<input data-field="model" value={product.model} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Referencia<input data-field="reference" value={product.reference} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Colorway<input data-field="colorway" value={product.colorway ?? ''} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Tipo<select data-field="type" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option value="CALZADO" selected={product.type === 'CALZADO'}>Calzado</option><option value="ROPA" selected={product.type === 'ROPA'}>Ropa</option><option value="ACCESORIO" selected={product.type === 'ACCESORIO'}>Accesorio</option><option value="OTRO" selected={product.type === 'OTRO'}>Otro</option></select></label></div><p data-edit-product-error class="mt-3 hidden text-sm font-medium text-rose-700"></p><div class="mt-6 flex justify-end gap-2"><button type="button" data-dialog-close class="min-h-11 rounded-xl border border-slate-200 px-4 font-semibold">Cancelar</button><button type="button" data-edit-product-save class="min-h-11 rounded-xl bg-slate-950 px-4 font-semibold text-white">Guardar</button></div></Modal>

    <Modal id="edit-variant" title="Editar talla" description="El stock se ajusta por separado."><div data-edit-variant-form class="grid grid-cols-2 gap-4"><label class="text-sm font-medium">Talla<input data-field="size" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Sistema<select data-field="sizeSystem" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option>EU</option><option>US</option><option>UK</option><option>CM</option><option>ALFABETICO</option><option>EDAD</option><option>ALTURA</option><option>DESCONOCIDO</option></select></label><label class="text-sm font-medium">PVP<input data-field="pvp" inputmode="decimal" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Precio oferta<input data-field="offer" inputmode="decimal" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">UPC<input data-field="barcode" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Género<select data-field="gender" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option>DESCONOCIDO</option><option>UNISEX</option><option>HOMBRE</option><option>MUJER</option><option>NINO</option><option>NINA</option></select></label><label class="text-sm font-medium">Edad<select data-field="ageGroup" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option>DESCONOCIDO</option><option>BEBE</option><option>INFANTIL</option><option>ADULTO</option></select></label></div><p data-edit-variant-error class="mt-3 hidden text-sm font-medium text-rose-700"></p><div class="mt-6 grid grid-cols-2 gap-2"><button type="button" data-dialog-close class="min-h-11 rounded-xl border border-slate-200 font-semibold">Cancelar</button><button type="button" data-edit-variant-save class="min-h-11 rounded-xl bg-slate-950 font-semibold text-white">Guardar</button></div></Modal>

    <Modal id="add-variant" title="Añadir talla" description="Hemos reutilizado los datos conocidos de otra talla. Puedes modificarlos antes de guardar."><div data-add-variant-form class="grid grid-cols-2 gap-4"><label class="text-sm font-medium">Talla<input data-field="size" value={addVariantDefaults.size} autofocus class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Sistema<select data-field="sizeSystem" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3"><option selected={addVariantDefaults.sizeSystem === 'EU'}>EU</option><option selected={addVariantDefaults.sizeSystem === 'US'}>US</option><option selected={addVariantDefaults.sizeSystem === 'UK'}>UK</option><option selected={addVariantDefaults.sizeSystem === 'CM'}>CM</option><option selected={addVariantDefaults.sizeSystem === 'ALFABETICO'}>ALFABETICO</option><option selected={addVariantDefaults.sizeSystem === 'EDAD'}>EDAD</option><option selected={addVariantDefaults.sizeSystem === 'ALTURA'}>ALTURA</option><option selected={addVariantDefaults.sizeSystem === 'DESCONOCIDO'}>DESCONOCIDO</option></select></label><label class="text-sm font-medium">Cantidad<input data-field="quantity" type="number" min="1" value={addVariantDefaults.quantity} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Ubicación<input data-field="location" value={addVariantDefaults.location} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">PVP<input data-field="pvp" value={addVariantDefaults.pvp} inputmode="decimal" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Precio oferta<input data-field="offer" value={addVariantDefaults.offer} inputmode="decimal" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">Coste<input data-field="cost" value={addVariantDefaults.cost} inputmode="decimal" class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label><label class="text-sm font-medium">UPC<input data-field="barcode" value={addVariantDefaults.barcode} class="mt-1.5 min-h-11 w-full rounded-xl border border-slate-200 px-3" /></label></div><p data-add-variant-error class="mt-3 hidden text-sm font-medium text-rose-700"></p><div class="mt-6 grid grid-cols-2 gap-2"><button type="button" data-dialog-close class="min-h-11 rounded-xl border border-slate-200 font-semibold">Cancelar</button><button type="button" data-add-variant-save class="min-h-11 rounded-xl bg-slate-950 font-semibold text-white">Añadir talla</button></div></Modal>

    <Modal id="archive-product" title="Dar de baja producto" description="El producto conservará todo su historial."><div class="rounded-xl bg-rose-50 p-3 text-sm font-semibold text-rose-800">{product.name}</div>{product.stock > 0 && <p class="mt-3 text-sm text-slate-600">Este producto todavía tiene {product.stock} unidades. Puedes cancelar o darlo de baja igualmente.</p>}<p data-archive-error class="mt-3 hidden text-sm font-medium text-rose-700"></p><div class="mt-6 grid grid-cols-2 gap-2"><button type="button" data-dialog-close class="min-h-12 rounded-xl border border-slate-200 font-semibold">Cancelar</button><button type="button" data-archive-save class="min-h-12 rounded-xl bg-rose-600 font-semibold text-white">Dar de baja</button></div></Modal>

    <script is:inline data-astro-rerun define:vars={{ productId: product.id, productStock: product.stock, productType: product.type, productReference: product.reference, addVariantGender: addVariantDefaults.gender, addVariantAgeGroup: addVariantDefaults.ageGroup }}>
      const galleryImages = [...document.querySelectorAll('[data-gallery-thumb]')].map((button) => button.dataset.imageUrl).filter(Boolean);
      const mainImage = document.querySelector('[data-gallery-main]');
      const currentDownload = document.querySelector('[data-download-current]');
      document.querySelectorAll('[data-gallery-thumb]').forEach((button) => button.addEventListener('click', () => {
        const imageUrl = button.dataset.imageUrl;
        if (!imageUrl || !mainImage || !currentDownload) return;
        mainImage.src = imageUrl;
        currentDownload.href = `${imageUrl}?download=1`;
        document.querySelectorAll('[data-gallery-thumb]').forEach((thumb) => {
          const selected = thumb === button;
          thumb.setAttribute('aria-pressed', String(selected));
          thumb.classList.toggle('ring-slate-950', selected);
          thumb.classList.toggle('ring-transparent', !selected);
        });
      }));
      document.querySelector('[data-download-all]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        const status = document.querySelector('[data-download-status]');
        button.disabled = true;
        if (status) { status.classList.remove('hidden'); status.textContent = `Preparando 0 de ${galleryImages.length} imágenes…`; }
        try {
          for (const [index, imageUrl] of galleryImages.entries()) {
            const response = await fetch(`${imageUrl}?download=1`);
            if (!response.ok) throw new Error(`No se pudo descargar la imagen ${index + 1}.`);
            const blobUrl = URL.createObjectURL(await response.blob());
            const disposition = response.headers.get('content-disposition') || '';
            const filename = disposition.match(/filename="([^"]+)"/)?.[1] || `imagen-${index + 1}.webp`;
            const anchor = document.createElement('a'); anchor.href = blobUrl; anchor.download = filename; document.body.append(anchor); anchor.click(); anchor.remove();
            window.setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
            if (status) status.textContent = `Preparando ${index + 1} de ${galleryImages.length} imágenes…`;
          }
          if (status) status.textContent = `${galleryImages.length} imágenes descargadas.`;
        } catch (cause) {
          if (status) status.textContent = cause instanceof Error ? cause.message : 'No se pudieron descargar todas las imágenes.';
        } finally { button.disabled = false; }
      });
      const jsonRequest = async (url, method, body) => { const response = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); const data = await response.json(); if (!response.ok) throw new Error(data.message || 'No hemos podido guardar los cambios.'); return data; };
      const fieldValues = (container) => Object.fromEntries([...container.querySelectorAll('[data-field]')].map((field) => [field.dataset.field, field.value.trim()]));
      const reloadWith = (message) => window.location.assign(`${window.location.pathname}?success=${encodeURIComponent(message)}`);
      const addVariantForm = document.querySelector('[data-add-variant-form]');
      const addVariantIdentifier = addVariantForm?.querySelector('[data-field="barcode"]');
      if (productType === 'ROPA' && addVariantIdentifier) {
        const label = addVariantIdentifier.closest('label');
        if (label?.firstChild) label.firstChild.textContent = 'Referencia';
        addVariantIdentifier.value = productReference;
        addVariantIdentifier.readOnly = true;
        addVariantIdentifier.removeAttribute('data-field');
      }
      const initialAddVariantValues = addVariantForm ? fieldValues(addVariantForm) : {};
      const fillAddVariantDefaults = () => {
        if (!addVariantForm) return;
        for (const [name, value] of Object.entries(initialAddVariantValues)) {
          const field = addVariantForm.querySelector(`[data-field="${name}"]`);
          if (field) field.value = value;
        }
        document.querySelector('[data-add-variant-error]')?.classList.add('hidden');
      };
      document.querySelectorAll('[data-dialog-open="add-variant"]').forEach((button) => button.addEventListener('click', fillAddVariantDefaults));
      const select = document.querySelector('[data-size-select]'); const current = document.querySelector('[data-stock-current]'); const renderCurrent = () => { if (current) current.textContent = select?.selectedOptions[0]?.dataset.quantity || '0'; }; select?.addEventListener('change', renderCurrent);
      document.querySelectorAll('[data-variant-stock]').forEach((button) => button.addEventListener('click', () => { if (select) select.value = button.dataset.variantId || select.value; renderCurrent(); document.querySelector('#adjust-stock')?.showModal(); }));
      const reason = document.querySelector('[data-stock-reason]'); const delta = document.querySelector('[data-stock-delta]'); reason?.addEventListener('change', () => { const amount = Math.max(1, Math.abs(Number(delta?.value) || 1)); if (delta) delta.value = reason.value === 'VENTA' ? String(-amount) : String(amount); });
      document.querySelector('[data-stock-save]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const error = document.querySelector('[data-stock-error]'); button.disabled = true; button.textContent = 'Guardando…'; try { const option = select.selectedOptions[0]; await jsonRequest(`/api/inventory/variants/${select.value}/stock`, 'POST', { locationId: option.dataset.locationId, reason: reason.value, delta: delta.value }); reloadWith('Stock actualizado'); } catch (cause) { error.textContent = cause.message; error.classList.remove('hidden'); } finally { button.disabled = false; button.textContent = 'Guardar'; } });
      document.querySelector('[data-edit-product-save]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const error = document.querySelector('[data-edit-product-error]'); button.disabled = true; button.textContent = 'Guardando…'; try { await jsonRequest(`/api/inventory/products/${productId}`, 'PATCH', fieldValues(document.querySelector('[data-edit-product-form]'))); reloadWith('Cambios guardados'); } catch (cause) { error.textContent = cause.message; error.classList.remove('hidden'); } finally { button.disabled = false; button.textContent = 'Guardar'; } });
      let editVariantId = ''; document.querySelectorAll('[data-variant-edit]').forEach((button) => button.addEventListener('click', () => { const variant = JSON.parse(button.dataset.variant); editVariantId = variant.id; const form = document.querySelector('[data-edit-variant-form]'); const values = { size: variant.size, sizeSystem: variant.sizeSystem, pvp: String((variant.compareAtPriceCents ?? variant.priceCents) / 100), offer: variant.compareAtPriceCents === null ? '' : String(variant.priceCents / 100), barcode: variant.barcode ?? '', gender: variant.gender, ageGroup: variant.ageGroup }; for (const [name, value] of Object.entries(values)) form.querySelector(`[data-field=${name}]`).value = value; document.querySelector('#edit-variant')?.showModal(); }));
      document.querySelector('[data-edit-variant-save]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const error = document.querySelector('[data-edit-variant-error]'); button.disabled = true; button.textContent = 'Guardando…'; try { await jsonRequest(`/api/inventory/variants/${editVariantId}`, 'PATCH', fieldValues(document.querySelector('[data-edit-variant-form]'))); reloadWith('Cambios guardados'); } catch (cause) { error.textContent = cause.message; error.classList.remove('hidden'); } finally { button.disabled = false; button.textContent = 'Guardar'; } });
      document.querySelector('[data-add-variant-save]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const error = document.querySelector('[data-add-variant-error]'); button.disabled = true; button.textContent = 'Guardando…'; try { const values = fieldValues(document.querySelector('[data-add-variant-form]')); values.gender = addVariantGender; values.ageGroup = addVariantAgeGroup; await jsonRequest(`/api/inventory/products/${productId}/variants`, 'POST', { variants: [values] }); reloadWith('Producto añadido'); } catch (cause) { error.textContent = cause.message; error.classList.remove('hidden'); } finally { button.disabled = false; button.textContent = 'Añadir talla'; } });
      document.querySelector('[data-archive-save]')?.addEventListener('click', async (event) => { const button = event.currentTarget; const error = document.querySelector('[data-archive-error]'); button.disabled = true; button.textContent = 'Guardando…'; try { await jsonRequest(`/api/inventory/products/${productId}/archive`, 'POST', { force: productStock > 0 }); window.location.assign('/stock?success=Producto+dado+de+baja'); } catch (cause) { error.textContent = cause.message; error.classList.remove('hidden'); } finally { button.disabled = false; button.textContent = 'Dar de baja'; } });
    </script>
  </>}
